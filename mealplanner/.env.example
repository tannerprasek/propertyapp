# Claude API key (or run `ant auth login` instead)
ANTHROPIC_API_KEY=

# Where the email link points. Must be reachable from her phone:
#   home Wi-Fi only:  http://<your-mac-name>.local:8765
#   anywhere:         your Tailscale / Cloudflare Tunnel URL
BASE_URL=http://localhost:8765
PORT=8765

# Schedule (local time)
TIMEZONE=America/Chicago
SEND_DAY=sun
SEND_HOUR=7
SEND_MINUTE=0
RECIPES_PER_WEEK=10

# Email (Gmail: use an App Password, https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
EMAIL_FROM=you@gmail.com
EMAIL_TO=wife@example.com
